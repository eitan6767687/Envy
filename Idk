        lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        lbl.Text = "0"
        lbl.Parent = bb
        
        RunService.RenderStepped:Connect(function()
            if not hrpOther or not hrpOther.Parent then return end
            local vel = hrpOther.AssemblyLinearVelocity
            local hSpd = Vector3.new(vel.X, 0, vel.Z).Magnitude
            lbl.Text = string.format("%.1f", hSpd)
            
