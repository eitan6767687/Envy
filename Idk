UIS.InputBegan:Connect(function(inp,gp)
    if gp or KeyListen.cb then return end
    if inp.KeyCode==Keys.guiHide then
        GuiRefs.outer.Visible=not GuiRefs.outer.Visible
    elseif inp.KeyCode==Keys.speed then
        if not canSwitchSpeed() then return end
        State.speedToggled=not State.speedToggled
        scheduleAutoSave(); updateFloatingButtons()
        if GuiToggleSetters["speed"] then GuiToggleSetters["speed"](State.speedToggled) end
    elseif inp.KeyCode==Keys.circle then
        toggleCircleCombat()
    elseif inp.KeyCode==Keys.dropBrainrot then
        runDropBrainrot()
    elseif inp.KeyCode==Keys.tpDown then
        tpDown()
    elseif inp.KeyCode==Keys.tpUp then
        tpUp()
    elseif inp.KeyCode==Keys.doubleJumpTp then
        setAutoDodgeState(not State.doubleJumpTpEnabled)
    elseif inp.KeyCode==Keys.laggerToggle then
        State.laggerModeEnabled=not State.laggerModeEnabled
        scheduleAutoSave(); updateFloatingButtons()
        if GuiToggleSetters["laggerToggle"] then GuiToggleSetters["laggerToggle"](State.laggerModeEnabled) end
    elseif inp.KeyCode==Keys.autoBaseSpeed then
        State.autoBaseSpeedEnabled=not State.autoBaseSpeedEnabled
        if State.autoBaseSpeedEnabled then startAutoBaseSpeed() else stopAutoBaseSpeed() end
        scheduleAutoSave()
    elseif inp.KeyCode==Keys.autoLeft then
        if State.autoLeftEnabled then stopAutoLeft() else queueAutoLeftStart() end
    elseif inp.KeyCode==Keys.autoRight then
        if State.autoRightEnabled then stopAutoRight() else queueAutoRightStart() end
    elseif inp.KeyCode==Keys.instaReset then
        instaReset()
    end
end)

-- ג”€ג”€ SPEED LOOP ג”€ג”€
do
    local MOVE_KEYS={[Enum.KeyCode.W]=true,[Enum.KeyCode.A]=true,[Enum.KeyCode.S]=true,[Enum.KeyCode.D]=true,[Enum.KeyCode.Up]=true,[Enum.KeyCode.Left]=true,[Enum.KeyCode.Down]=true,[Enum.KeyCode.Right]=true}
    RunService.RenderStepped:Connect(function()
        local h,hrp,lbl=CharRefs.humanoid,CharRefs.hrp,CharRefs.speedLabel
        if not (h and hrp) then return end
        if State.tpInProgress or State.circleEnabled then return end
        local md=h.MoveDirection; local spd=getCurrentSpeed()
        if md.Magnitude>0 then State.lastMoveDir=md; hrp.Velocity=Vector3.new(md.X*spd,hrp.Velocity.Y,md.Z*spd)
        elseif State.antiRagdollEnabled and State.lastMoveDir.Magnitude>0 then
            local anyHeld=false; for key in pairs(MOVE_KEYS) do if UIS:IsKeyDown(key) then anyHeld=true; break end end
            if anyHeld then hrp.Velocity=Vector3.new(State.lastMoveDir.X*spd,hrp.Velocity.Y,State.lastMoveDir.Z*spd) end
        end
        if lbl then lbl.Text="Speed: "..string.format("%.1f",Vector3.new(hrp.Velocity.X,0,hrp.Velocity.Z).Magnitude) end
    end)
end

-- ג”€ג”€ NO COLLIDE ג”€ג”€
do
    local trackedPlayers={}
    local function disableCanCollide(part) if part:IsA("BasePart") and part.CanCollide then part.CanCollide=false end end
    local function trackCharacter(character) for _,part in pairs(character:GetChildren()) do disableCanCollide(part) end; character.ChildAdded:Connect(function(child) disableCanCollide(child) end) end
    local function trackPlayer(player) if player==LP then return end; if player.Character then trackCharacter(player.Character) end; player.CharacterAdded:Connect(trackCharacter); trackedPlayers[player]=true end
    for _,player in pairs(Players:GetPlayers()) do trackPlayer(player) end
    Players.PlayerAdded:Connect(trackPlayer)
    RunService.RenderStepped:Connect(function() for player,_ in pairs(trackedPlayers) do local character=player.Character; if character then for _,part in pairs(character:GetChildren()) do disableCanCollide(part) end end end end)
end

