-- ג”€ג”€ INSTANT RESET ג”€ג”€
local resetRemote = nil
local instaResetCooldown = false
local INSTA_RESET_GUID = "f888ee6e-c86d-46e1-93d7-0639d6635d42"

pcall(function()
    if hookfunction and newcclosure then
        local probe = Instance.new("RemoteEvent")
        local original
        original = hookfunction(probe.FireServer, newcclosure(function(self, ...)
            if not resetRemote and typeof(self) == "Instance" and self:IsA("RemoteEvent") and self.Name:sub(1, 3) == "RE/" then
                resetRemote = self
            end
            return original(self, ...)
        end))
    end
end)

local function instaReset()
    if instaResetCooldown then return end
    if not resetRemote then return end
    instaResetCooldown = true
    local oldChar = LP.Character
    task.spawn(function()
        while LP.Character == oldChar do
            pcall(function() resetRemote:FireServer(INSTA_RESET_GUID, LP, "balloon") end)
            task.wait()
        end
        instaResetCooldown = false
    end)
end

-- ג”€ג”€ AUTO BASE SPEED (ENEMY BASE SWITCH) ג”€ג”€
local BASEDETECT_RADIUS = 3.5
local ConnsAutoBase = nil

local function startAutoBaseSpeed()
    if ConnsAutoBase then ConnsAutoBase:Disconnect() end
    ConnsAutoBase = RunService.Heartbeat:Connect(function()
        if not State.autoBaseSpeedEnabled then return end
        local char = LP.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return end
        
        local inEnemyBase = false
        local myPlotName = nil
        
        -- Trouver sa propre base
        for _, plot in ipairs(plots:GetChildren()) do
            local sign = plot:FindFirstChild("PlotSign")
            if sign then
                local yourBase = sign:FindFirstChild("YourBase")
                if yourBase and yourBase:IsA("BillboardGui") and yourBase.Enabled then
                    myPlotName = plot.Name
                    break
                end
            end
        end
        
        -- Vֳ©rifier si dans une base ennemie
        for _, plot in ipairs(plots:GetChildren()) do
            if plot.Name ~= myPlotName then
                for _, part in ipairs(plot:GetDescendants()) do
                    if part:IsA("BasePart") and not part.Name:lower():find("sign") then
                        if (part.Position - root.Position).Magnitude <= BASEDETECT_RADIUS then
                            inEnemyBase = true
                            break
                        end
                    end
                end
            end
            if inEnemyBase then break end
        end
        
        if inEnemyBase and not State.wasInEnemyBase then
            State.speedToggled = true
        elseif not inEnemyBase and State.wasInEnemyBase then
            -- Optionnel: dֳ©sactiver carry mode en sortant
            -- State.speedToggled = false
        end
        State.wasInEnemyBase = inEnemyBase
    end)
end

local function stopAutoBaseSpeed()
    if ConnsAutoBase then
        ConnsAutoBase:Disconnect()
        ConnsAutoBase = nil
    end
    State.wasInEnemyBase = false
end

