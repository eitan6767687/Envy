    if State.stretchRezEnabled then enableStretchRez() else disableStretchRez(); pcall(function() workspace.CurrentCamera.FieldOfView = 70 end) end
    if State.ragdollTimerEnabled then else stopRagdollTimer(); destroyRagdollBillboard() end
    pcall(function() workspace.CurrentCamera.FieldOfView = State.stretchRezEnabled and 107 or 70 end)
    if State.antiRagdollEnabled then startAntiRagdoll() end
    if State.fpsBoostEnabled then applyFPSBoost() end
    if State.medusaCounterEnabled then setupMedusaCounter(LP.Character) end
    if State.batCounterEnabled then startBatCounter() end
    if State.unwalkEnabled then startUnwalk() end
    if State.batAimbotToggled then pcall(startBatAimbot) end

    refreshMobileVisibility()
    updateAllMobileDots()
end

