local CORNER_RADIUS = 24

local function mkCorner(p,r)
    local c = Instance.new("UICorner",p)
    c.CornerRadius = UDim.new(0,r or CORNER_RADIUS)
    return c
end

local function mkStroke(p,col,th)
    local s = Instance.new("UIStroke",p)
    s.Color = col
    s.Thickness = th or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    return s
end

local function getKeyDisplayName(kc)
    if not kc or kc == Enum.KeyCode.Unknown then return "--" end
    local n = kc.Name
    if n == "LeftControl" then return "CTRL" end
    if n == "RightControl" then return "RCTRL" end
    if n == "LeftShift" then return "SHFT" end
    if n == "Space" then return "SPC" end
    local gp = {
        ButtonA = "A", ButtonB = "B", ButtonX = "X", ButtonY = "Y",
        ButtonL1 = "LB", ButtonL2 = "LT", ButtonL3 = "LS",
        ButtonR1 = "RB", ButtonR2 = "RT", ButtonR3 = "RS",
        DPadUp = "DUP", DPadDown = "DDOWN", DPadLeft = "DLEFT", DPadRight = "DRIGHT"
    }
    if gp[n] then return gp[n] end
    return n:sub(1,5)
end

function createKeybindButton(parent, currentKey, onChanged, extraWidth)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0, extraWidth or 72, 0, 26)
    btn.BackgroundColor3 = C.INPUT
    btn.BorderSizePixel = 0
    btn.Text = getKeyDisplayName(currentKey)
    btn.TextColor3 = C.WHITE
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.ZIndex = 8
    mkCorner(btn, 0)
    local stroke = mkStroke(btn, C.BORDER_LT, 1)

    local listening = false
    local conn = nil
    local function stopListening(newKey)
        listening = false
        if conn then conn:Disconnect(); conn = nil end
        TweenService:Create(stroke, TweenInfo.new(0.12), {Color = C.BORDER_LT}):Play()
        btn.TextColor3 = C.WHITE
        if newKey and newKey ~= Enum.KeyCode.Unknown then
            btn.Text = getKeyDisplayName(newKey)
            if onChanged then onChanged(newKey) end
            pcall(saveConfig)
        else
            btn.Text = getKeyDisplayName(currentKey)
        end
    end

    btn.MouseButton1Click:Connect(function()
        if listening then stopListening(nil); return end
        listening = true
        btn.Text = "Press key/btn"
        btn.TextColor3 = C.WHITE_GLW
        TweenService:Create(stroke, TweenInfo.new(0.12), {Color = C.ACCENT}):Play()
        conn = UserInputService.InputBegan:Connect(function(inp, gp)
            if not listening then return end
            if gp then return end
            local valid = inp.UserInputType == Enum.UserInputType.Keyboard or
                          inp.UserInputType == Enum.UserInputType.Gamepad1 or
                          inp.UserInputType == Enum.UserInputType.Gamepad2 or
                          inp.UserInputType == Enum.UserInputType.Gamepad3 or
                          inp.UserInputType == Enum.UserInputType.Gamepad4
            if not valid then return end
            if inp.KeyCode == Enum.KeyCode.Escape then stopListening(nil); return end
            stopListening(inp.KeyCode)
        end)
    end)
    return btn, stroke
end

local function makeDraggable(frame, handle)
    local src = handle or frame
    local dragging = false; local dragInput = nil; local dragStart = nil; local startPos = nil
    src.InputBegan:Connect(function(inp)
        if State.uiLocked then return end
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = inp.Position; startPos = frame.Position
            inp.Changed:Connect(function() if inp.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    src.InputChanged:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then dragInput = inp end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if inp == dragInput and dragging and not State.uiLocked then
            local dx = inp.Position.X - dragStart.X; local dy = inp.Position.Y - dragStart.Y
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + dx, startPos.Y.Scale, startPos.Y.Offset + dy)
        end
    end)
end

