local function startRagdollTimerAboveHead()
    if not State.ragdollTimerEnabled then return end
    stopRagdollTimer()
    createRagdollBillboard()
    if not ragdollLabel or not ragdollShadow then return end

    ragdollLabel.Visible = true
    ragdollLabel.TextTransparency = 0
    ragdollLabel.Size = UDim2.new(1,0,1,0)
    ragdollShadow.Visible = true
    ragdollShadow.TextTransparency = 0
    ragdollShadow.Size = UDim2.new(1,0,1,0)
    local countdown = 3
    ragdollLabel.Text = tostring(countdown)
    ragdollShadow.Text = tostring(countdown)

    local function pulse()
        if ragdollAnimTween then ragdollAnimTween:Cancel() end
        ragdollAnimTween = TweenService:Create(ragdollLabel, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(1.3,0,1.3,0)
        })
        ragdollAnimTween:Play()
        TweenService:Create(ragdollShadow, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(1.3,0,1.3,0)
        }):Play()
        task.wait(0.15)
        ragdollAnimTween = TweenService:Create(ragdollLabel, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(1,0,1,0)
        })
        ragdollAnimTween:Play()
        TweenService:Create(ragdollShadow, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(1,0,1,0)
        }):Play()
    end

    ragdollTimerCoroutine = task.spawn(function()
        local startTime = tick()
        while countdown > 0 do
            local elapsed = tick() - startTime
            local waitTime = 1 - (elapsed % 1)
            if waitTime < 0.01 then waitTime = 0.01 end
            task.wait(waitTime)
            countdown = countdown - 1
            if countdown > 0 then
                ragdollLabel.Text = tostring(countdown)
                ragdollShadow.Text = tostring(countdown)
                pulse()
            else
                ragdollLabel.Text = "CAN STEAL!"
                ragdollShadow.Text = "CAN STEAL!"
                if ragdollAnimTween then ragdollAnimTween:Cancel() end
                ragdollAnimTween = TweenService:Create(ragdollLabel, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Size = UDim2.new(1.5,0,1.5,0)
                })
                ragdollAnimTween:Play()
                TweenService:Create(ragdollShadow, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Size = UDim2.new(1.5,0,1.5,0)
                }):Play()
                task.wait(1.5)
                TweenService:Create(ragdollLabel, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
                TweenService:Create(ragdollShadow, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
                task.wait(0.5)
                ragdollLabel.Visible = false
                ragdollLabel.TextTransparency = 0
                ragdollLabel.Size = UDim2.new(1,0,1,0)
                ragdollShadow.Visible = false
                ragdollShadow.TextTransparency = 0
                ragdollShadow.Size = UDim2.new(1,0,1,0)
                ragdollTimerCoroutine = nil
                return
            end
        end
    end)
end

