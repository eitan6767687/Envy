UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.UserInputType ~= Enum.UserInputType.Keyboard and
       inp.UserInputType ~= Enum.UserInputType.Gamepad1 and
       inp.UserInputType ~= Enum.UserInputType.Gamepad2 and
       inp.UserInputType ~= Enum.UserInputType.Gamepad3 and
       inp.UserInputType ~= Enum.UserInputType.Gamepad4 then return end
    local kc = inp.KeyCode; if kc == Enum.KeyCode.Unknown then return end

    if kc == Keys.speedToggle then
        State.speedToggled = not State.speedToggled
        if State.speedToggled then State.laggerPhase = 0; State.laggerEnabled = false end
        updateAllMobileDots()
    elseif kc == Keys.laggerToggle then
        State.laggerPhase = (State.laggerPhase + 1) % 3
        if State.laggerPhase > 0 then State.speedToggled = false; State.laggerEnabled = false
        else State.laggerEnabled = false end
        updateAllMobileDots()
    elseif kc == Keys.autoLeft then
        State.autoLeftEnabled = not State.autoLeftEnabled
        if State.autoLeftEnabled and State.batAimbotToggled then State.batAimbotToggled = false; stopBatAimbot() end
        if State.autoLeftEnabled then startAutoLeft() else stopAutoLeft() end
        updateAllMobileDots()
    elseif kc == Keys.autoRight then
        State.autoRightEnabled = not State.autoRightEnabled
        if State.autoRightEnabled and State.batAimbotToggled then State.batAimbotToggled = false; stopBatAimbot() end
        if State.autoRightEnabled then startAutoRight() else stopAutoRight() end
        updateAllMobileDots()
    elseif kc == Keys.drop then
        if not State.dropEnabled then runDropBrainrot() end
    elseif kc == Keys.aimbot then
        State.batAimbotToggled = not State.batAimbotToggled
        if State.batAimbotToggled then
            if State.autoLeftEnabled then State.autoLeftEnabled = false; stopAutoLeft() end
            if State.autoRightEnabled then State.autoRightEnabled = false; stopAutoRight() end
            pcall(startBatAimbot)
        else stopBatAimbot() end
        updateAllMobileDots()
    elseif kc == Keys.duelLagger then
        if State._toggleDuelLaggerFn then State._toggleDuelLaggerFn() end
    elseif kc == Keys.tpDown then
        doTpDown()
    elseif kc == Keys.guiHide then
        State.guiVisible = not State.guiVisible
        if State.guiVisible then
            mainOuter.Visible = true
            mainOuter.Size = UDim2.new(0, 0, 0, 0)
            TweenService:Create(mainOuter, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, WIN_W, 0, WIN_H)
            }):Play()
        else
            TweenService:Create(mainOuter, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0)
            }):Play()
            task.wait(0.3)
            mainOuter.Visible = false
        end
    end
end)

