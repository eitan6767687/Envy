        return
    elseif State.laggerPhase == 1 then
        local spd = State.laggerSpeed
        local md = hum.MoveDirection
        if md.Magnitude > 0 then hrp2.Velocity = Vector3.new(md.X * spd, hrp2.Velocity.Y, md.Z * spd) end
        return
    elseif State.laggerPhase == 2 then
        local spd = State.laggerCarrySpeed
        local md = hum.MoveDirection
        if md.Magnitude > 0 then hrp2.Velocity = Vector3.new(md.X * spd, hrp2.Velocity.Y, md.Z * spd) end
        return
    end

    if State.speedToggled then
