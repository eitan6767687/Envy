local function applySkyMode(modeName)
    if modeName == "None" then
        Lighting.Brightness = defBrightness; Lighting.ClockTime = defClockTime
        Lighting.ExposureCompensation = defExposureComp; Lighting.OutdoorAmbient = defOutdoorAmbient
        Lighting.FogEnd = 9e9; Lighting.FogColor = Color3.fromRGB(191,191,191); Lighting.FogStart = 0; return
    end
    if modeName == "Night" then
        Lighting.ClockTime = 0; Lighting.Brightness = 0.5; Lighting.ExposureCompensation = -1
        Lighting.OutdoorAmbient = Color3.fromRGB(10,10,40); Lighting.FogEnd = 9e9; Lighting.FogStart = 0
        Lighting.Ambient = Color3.fromRGB(20,20,60)
    elseif modeName == "Sunset" then
        Lighting.ClockTime = 18.5; Lighting.Brightness = 2; Lighting.ExposureCompensation = 0
        Lighting.OutdoorAmbient = Color3.fromRGB(180,100,50); Lighting.FogEnd = 800; Lighting.FogStart = 100
        Lighting.FogColor = Color3.fromRGB(255,160,80)
    elseif modeName == "Storm" then
        Lighting.ClockTime = 14; Lighting.Brightness = 0.3; Lighting.ExposureCompensation = -0.5
        Lighting.OutdoorAmbient = Color3.fromRGB(50,50,60); Lighting.FogEnd = 400; Lighting.FogStart = 50
        Lighting.FogColor = Color3.fromRGB(70,70,80)
    elseif modeName == "Pink" then
        Lighting.ClockTime = 6; Lighting.Brightness = 4; Lighting.ExposureCompensation = 1
        Lighting.OutdoorAmbient = Color3.fromRGB(255,80,200); Lighting.FogEnd = 200; Lighting.FogStart = 20
        Lighting.FogColor = Color3.fromRGB(255,60,180); Lighting.Ambient = Color3.fromRGB(255,50,170)
    elseif modeName == "Neon" then
        Lighting.ClockTime = 0; Lighting.Brightness = 0.2; Lighting.ExposureCompensation = -0.5
        Lighting.OutdoorAmbient = Color3.fromRGB(0,80,60); Lighting.FogEnd = 300; Lighting.FogStart = 30
        Lighting.FogColor = Color3.fromRGB(0,255,180)
    end
end

