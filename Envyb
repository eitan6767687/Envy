local function makeTabBtn(name, order)
    local isAct = (name == currentTab)
    local btn = Instance.new("TextButton", tabList)
    btn.Size = UDim2.new(0.85, 0, 0, TAB_BTN_H)
    btn.BackgroundColor3 = isAct and C.WHITE_DK or Color3.fromRGB(50,50,50)
    btn.BackgroundTransparency = isAct and 0.1 or 0.4
    btn.BorderSizePixel = 0
    btn.Text = name
    btn.TextColor3 = isAct and C.WHITE or C.GRAY_L
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.TextWrapped = true
    btn.LayoutOrder = order
    btn.ZIndex = 22
    mkCorner(btn, 4)
    local tabStroke = mkStroke(btn, isAct and Color3.fromRGB(200,200,200) or Color3.fromRGB(0,0,0), 1)
    local indicator = Instance.new("Frame", btn)
    indicator.Size = UDim2.new(0,4,0.5,0)
    indicator.Position = UDim2.new(1,-4,0.5,0)
    indicator.BackgroundColor3 = C.WHITE
    indicator.BorderSizePixel = 0
    indicator.ZIndex = 24
    indicator.Visible = isAct
    mkCorner(indicator, 2)

    btn.MouseButton1Click:Connect(function()
        currentTab = name
        for _, td in ipairs(TABS) do
            local b = tabBtnRefs[td]
            if b then
                local isA = (td == name)
                TweenService:Create(b.btn, TweenInfo.new(0.15), {BackgroundColor3 = isA and C.WHITE_DK or Color3.fromRGB(50,50,50), BackgroundTransparency = isA and 0.1 or 0.4}):Play()
                TweenService:Create(b.btn, TweenInfo.new(0.15), {TextColor3 = isA and C.WHITE or C.GRAY_L}):Play()
                b.ind.Visible = isA
                if tabPages[td] then tabPages[td].Visible = isA end
                local stroke = b.btn:FindFirstChild("UIStroke")
                if stroke then stroke.Color = isA and Color3.fromRGB(200,200,200) or Color3.fromRGB(0,0,0) end
            end
        end
    end)

    tabBtnRefs[name] = {btn = btn, ind = indicator, stroke = tabStroke}
end

