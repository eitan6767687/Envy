    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 12
    valLbl.TextXAlignment = Enum.TextXAlignment.Right

    local slTrack = Instance.new("Frame", container)
    slTrack.Size = UDim2.new(1,-20,0,4)
    slTrack.Position = UDim2.new(0,10,0,42)
    slTrack.BackgroundColor3 = C.GRAY_D
    slTrack.BorderSizePixel = 0
    mkCorner(slTrack, 2)

    local slFill = Instance.new("Frame", slTrack)
    slFill.Size = UDim2.new((defaultV - minV) / (maxV - minV), 0, 1, 0)
    slFill.BackgroundColor3 = C.WHITE
    slFill.BorderSizePixel = 0
    mkCorner(slFill, 2)

    local slHandle = Instance.new("Frame", slTrack)
    slHandle.Size = UDim2.new(0,14,0,14)
    slHandle.Position = UDim2.new((defaultV - minV) / (maxV - minV), -7, 0.5, -7)
    slHandle.BackgroundColor3 = C.WHITE_GLW
    slHandle.BorderSizePixel = 0
    mkCorner(slHandle, 7)
    mkStroke(slHandle, C.BORDER, 1.5)

    local slBtn = Instance.new("TextButton", slTrack)
    slBtn.Size = UDim2.new(1,0,0,28)
    slBtn.Position = UDim2.new(0,0,0.5,-14)
    slBtn.BackgroundTransparency = 1
    slBtn.Text = ""
    slBtn.ZIndex = 7
    slBtn.BorderSizePixel = 0

    local curVal = defaultV
    local isDragging = false
    local function setVal(v)
        v = math.clamp(v, minV, maxV)
        if math.floor(minV) == minV and math.floor(maxV) == maxV and (maxV - minV) <= 10 then v = math.floor(v + 0.5) end
        curVal = v
        local t = (v - minV) / (maxV - minV)
        slFill.Size = UDim2.new(t, 0, 1, 0)
        slHandle.Position = UDim2.new(t, -7, 0.5, -7)
        if math.floor(v) == v then valLbl.Text = tostring(math.floor(v)) .. suffix else valLbl.Text = string.format("%.2f", v) .. suffix end
        if onChange then onChange(v) end
        pcall(saveConfig)
    end

    local function updateFromInput(inp)
        local ta = slTrack.AbsolutePosition
        local tw = slTrack.AbsoluteSize.X
        local rx = math.clamp(inp.Position.X - ta.X, 0, tw)
        setVal(minV + (rx / tw) * (maxV - minV))
    end

    slBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            updateFromInput(inp)
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if not isDragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then updateFromInput(inp) end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then isDragging = false end
    end)

    return setVal, function() return curVal end
end

