-- SPEED METER
local speedMeterLabel = nil
local lastTargetSpeed = 0
local smoothedSpeed = 0
local speedUpdateConn = nil

local function getCurrentTargetSpeed()
    if State.laggerEnabled then
        return State.laggerSpeed
    elseif State.laggerPhase == 1 then
        return State.laggerSpeed
    elseif State.laggerPhase == 2 then
        return State.laggerCarrySpeed
    elseif State.speedToggled then
        return State.carrySpeed
    else
        return State.normalSpeed
    end
end

local function setupSpeedMeter(char)
    task.wait(0.1)
    local head = char:FindFirstChild("Head")
    if not head then return end
    local existing = head:FindFirstChild("ZeroVsSpeedMeter")
    if existing then existing:Destroy() end

    local bb = Instance.new("BillboardGui", head)
    bb.Name = "ZeroVsSpeedMeter"
    bb.Size = UDim2.new(0, 220, 0, 85)
    bb.StudsOffset = Vector3.new(0, 3.5, 0)
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0

    local lbl = Instance.new("TextLabel", bb)
    lbl.Size = UDim2.new(1, 0, 0, 38)
    lbl.BackgroundTransparency = 1
    lbl.Text = "0.0"
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.GothamBlack
    lbl.TextScaled = true
    lbl.TextStrokeTransparency = 0.6
    lbl.TextStrokeColor3 = Color3.new(0,0,0)
    speedMeterLabel = lbl

    local modeLbl = Instance.new("TextLabel", bb)
    modeLbl.Size = UDim2.new(1, 0, 0, 24)
    modeLbl.Position = UDim2.new(0, 0, 0, 40)
    modeLbl.BackgroundTransparency = 1
    modeLbl.Text = "NORMAL"
    modeLbl.TextColor3 = Color3.fromRGB(180, 180, 255)
    modeLbl.Font = Enum.Font.GothamBold
    modeLbl.TextSize = 16
    modeLbl.TextStrokeTransparency = 0.7

    local discordLbl = Instance.new("TextLabel", bb)
    discordLbl.Size = UDim2.new(1, 0, 0, 20)
    discordLbl.Position = UDim2.new(0, 0, 0, 65)
    discordLbl.BackgroundTransparency = 1
    discordLbl.Text = "discord.gg/zero.vs"
    discordLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    discordLbl.Font = Enum.Font.GothamBold
    discordLbl.TextSize = 12
    discordLbl.TextStrokeTransparency = 0.7

    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if speedUpdateConn then speedUpdateConn:Disconnect() end
    speedUpdateConn = RunService.RenderStepped:Connect(function(dt)
        if not root or not root.Parent then speedUpdateConn:Disconnect(); return end
        local targetSpd = getCurrentTargetSpeed()
        local actualHspd = Vector3.new(root.Velocity.X, 0, root.Velocity.Z).Magnitude
        smoothedSpeed = smoothedSpeed + (actualHspd - smoothedSpeed) * 12 * dt
        if speedMeterLabel then speedMeterLabel.Text = string.format("%.1f", targetSpd) end
        local modeText, modeColor = "NORMAL", Color3.fromRGB(180,180,255)
        if State.laggerEnabled then
            modeText, modeColor = "LAGGER", Color3.fromRGB(255,100,100)
        elseif State.laggerPhase == 1 then
            modeText, modeColor = "LAGGER", Color3.fromRGB(255,100,100)
        elseif State.laggerPhase == 2 then
            modeText, modeColor = "LAG CARRY", Color3.fromRGB(255,160,60)
        elseif State.speedToggled then
            modeText, modeColor = "CARRY", Color3.fromRGB(100,255,160)
        end
        modeLbl.Text = modeText; modeLbl.TextColor3 = modeColor
        if math.abs(targetSpd - lastTargetSpeed) > 0.5 then
            lastTargetSpeed = targetSpd
            TweenService:Create(lbl, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {TextTransparency = 0.3}):Play()
            task.delay(0.1, function() if lbl then TweenService:Create(lbl, TweenInfo.new(0.2), {TextTransparency = 0}):Play() end end)
        end
    end)
end

