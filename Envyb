local function updateMobileDot(ref)
    local def = ref.def
    if def.state then
        local isOn = def.state()
        ref.dot.BackgroundColor3 = isOn and C.dotGreenOn or C.dotGreenOff
        ref.btn.BackgroundColor3 = isOn and C.MOB_BG_ON or C.MOB_BG
    end
end

local function updateAllMobileDots()
    for _, ref in ipairs(mobileBtnRefs) do
        updateMobileDot(ref)
    end
end

local function refreshMobileVisibility()
    for _, ref in ipairs(mobileBtnRefs) do
        if ref.frame then
            ref.frame.Visible = State.mobileMasterVisible
            ref.frame.Active = State.mobileMasterVisible
            if ref.btn then
                ref.btn.Active = State.mobileMasterVisible
            end
        end
    end
end

-- Bulletproof visibility force (use this for hide toggle)
local function forceMobileVisibility(visible)
    State.mobileMasterVisible = visible
    for _, ref in ipairs(mobileBtnRefs) do
        if ref.frame then
            ref.frame.Visible = visible
            ref.frame.Active = visible
            if ref.btn then ref.btn.Active = visible end
        end
    end
end

local function saveMobileButtonPositions()
    local positions = {}
    for _, ref in ipairs(mobileBtnRefs) do
        local pos = ref.frame.Position
        positions[ref.key] = {X = {Scale = pos.X.Scale, Offset = pos.X.Offset}, Y = {Scale = pos.Y.Scale, Offset = pos.Y.Offset}}
    end
    local encoded = HttpService:JSONEncode(positions)
    _writefile(MOBILE_BTN_POS_FILE, encoded)
end

local function loadMobileButtonPositions()
    if not _isfile(MOBILE_BTN_POS_FILE) then return end
    local raw = _readfile(MOBILE_BTN_POS_FILE)
    if not raw then return end
    local positions = HttpService:JSONDecode(raw)
    if not positions then return end
    for _, ref in ipairs(mobileBtnRefs) do
        local posData = positions[ref.key]
        if posData then
            ref.frame.Position = UDim2.new(posData.X.Scale, posData.X.Offset, posData.Y.Scale, posData.Y.Offset)
        end
    end
end

