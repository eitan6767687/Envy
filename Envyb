    dot.BorderSizePixel = 0
    dot.ZIndex = 19
    mkCorner(dot, 5)

    -- Clean tap + drag separation (optimized for touch devices)
    local dragStart = nil
    local startPos  = nil
    local isDragging = false
    local DRAG_THRESH = 14

    -- Reliable instant tap (always works, even when locked)
    btn.Activated:Connect(function()
        if isDragging then return end
        pcall(def.onClick)
        if updateMobileDot then
            updateMobileDot({key = def.key, def = def, dot = dot, btn = btn, stroke = btnStroke, frame = btnFrame})
        end
    end)

    -- Drag handling attached to the visible button for best touch capture
    btn.InputBegan:Connect(function(inp)
        if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
        if State.lockButtonsEnabled then return end
        dragStart = inp.Position
        startPos  = btnFrame.Position
        isDragging = false
        btn.BackgroundColor3 = Color3.fromRGB(40, 45, 40)
    end)

    UserInputService.InputChanged:Connect(function(inp)
        if not dragStart or State.lockButtonsEnabled then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = inp.Position - dragStart
        local dist = math.abs(delta.X) + math.abs(delta.Y)
        if dist > DRAG_THRESH then
            isDragging = true
            btnFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
        if not dragStart then return end

        if isDragging then
            pcall(saveMobileButtonPositions)
        end

        if updateMobileDot then
            updateMobileDot({key = def.key, def = def, dot = dot, btn = btn, stroke = btnStroke, frame = btnFrame})
        end
        dragStart = nil
        isDragging = false
        -- Restore normal color after interaction
        if updateMobileDot then
            updateMobileDot({key = def.key, def = def, dot = dot, btn = btn, stroke = btnStroke, frame = btnFrame})
        end
    end)

    table.insert(mobileBtnRefs, {key = def.key, def = def, dot = dot, btn = btn, stroke = btnStroke, frame = btnFrame})
    return btnFrame
end

