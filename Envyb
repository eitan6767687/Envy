        if not State.batCounterEnabled or State.batCounterDebounce then return end
        local char = LP.Character; if not char then return end
        local hum2 = char:FindFirstChildOfClass("Humanoid"); if not hum2 then return end
        local st = hum2:GetState()
        local isRagdolled = st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown
        if isRagdolled then
            if State.ragdollTimerEnabled then startRagdollTimerAboveHead() end
            State.batCounterDebounce = true
            task.spawn(function()
                local root = char:FindFirstChild("HumanoidRootPart"); local bat = findBatForCounter()
                if bat then
                    if bat.Parent ~= char then pcall(function() hum2:EquipTool(bat) end) end
                    if root then
                        local target = getNearestAttacker(); local tHRP = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
                        if tHRP then
                            local dir = (tHRP.Position - root.Position).Unit; local flatDir = Vector3.new(dir.X, 0, dir.Z)
                            if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
                                local cam = workspace.CurrentCamera; local camFlat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
                                if camFlat.Magnitude > 0 then flatDir = camFlat.Unit end
                            end
                            root.CFrame = CFrame.lookAt(root.Position, root.Position + flatDir); root.Velocity = dir * 75
                        end
                    end
                    pcall(function() bat:Activate() end); task.wait(0.15); pcall(function() bat:Activate() end)
                end
                task.wait(0.5); State.batCounterDebounce = false
            end)
        end
    end)
end

stopBatCounter = function()
    if Conns2.batCounter then Conns2.batCounter:Disconnect(); Conns2.batCounter = nil end
    State.batCounterDebounce = false
end

-- MEDUSA COUNTER
local function findMedusa()
    local c = LP.Character; if not c then return nil end
    for _, t in ipairs(c:GetChildren()) do if t:IsA("Tool") then local n = t.Name:lower(); if n:find("medusa") or n:find("head") or n:find("stone") then return t end end end
    local bp = LP:FindFirstChild("Backpack")
    if bp then for _, t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then local n = t.Name:lower(); if n:find("medusa") or n:find("head") or n:find("stone") then return t end end end end
    return nil
end

local function useMedusaCounter()
    if State.medusaDebounce or tick() - State.medusaLastUsed < 25 then return end
    local c = LP.Character; if not c then return end; State.medusaDebounce = true
    local med = findMedusa(); if not med then State.medusaDebounce = false; return end
    if med.Parent ~= c then local hum2 = c:FindFirstChildOfClass("Humanoid"); if hum2 then hum2:EquipTool(med) end end
    pcall(function() med:Activate() end); State.medusaLastUsed = tick(); State.medusaDebounce = false
    if State.ragdollTimerEnabled then startRagdollTimerAboveHead() end
end

local function onAnchorChanged(part)
    return part:GetPropertyChangedSignal("Anchored"):Connect(function()
        if part.Anchored and part.Transparency == 1 then useMedusaCounter() end
    end)
end

setupMedusaCounter = function(char)
    for _, c2 in pairs(Conns2.anchor) do pcall(function() c2:Disconnect() end) end; Conns2.anchor = {}
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then table.insert(Conns2.anchor, onAnchorChanged(part)) end end
    table.insert(Conns2.anchor, char.DescendantAdded:Connect(function(part) if part:IsA("BasePart") then table.insert(Conns2.anchor, onAnchorChanged(part)) end end))
end

stopMedusaCounter = function()
    for _, c2 in pairs(Conns2.anchor) do pcall(function() c2:Disconnect() end) end; Conns2.anchor = {}
end

-- UNWALK
local _unwalkSavedAnimate = nil
local function startUnwalk()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
            pcall(function() track:Stop() end)
        end
    end
    local animate = char:FindFirstChild("Animate")
    if animate then
        _unwalkSavedAnimate = animate:Clone()
        animate:Destroy()
    end
end

local function stopUnwalk()
    local char = LP.Character
    if not char then _unwalkSavedAnimate = nil; return end
    local existing = char:FindFirstChild("Animate")
    if not existing and _unwalkSavedAnimate then
        _unwalkSavedAnimate:Clone().Parent = char
    end
    _unwalkSavedAnimate = nil
end

